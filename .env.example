# --- Database (Neon / Supabase free tier Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/dhanwantari"
DIRECT_URL="postgresql://user:password@localhost:5432/dhanwantari"

# --- Auth.js ---
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Email notifications (free SMTP, e.g. Gmail App Password or Resend free plan) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Dhanwantari Healthcare <no-reply@dhanwantari.local>"

# --- Notification adapter mode: "email" | "console" (no paid SMS/WhatsApp by default) ---
NOTIFICATION_PROVIDER="console"

# --- TOTP 2FA ---
TOTP_APP_NAME="Dhanwantari Healthcare"

# --- App ---
NODE_ENV="development"

# --- One-time demo data seeding via browser (visit /api/setup?secret=THIS_VALUE) ---
SEED_SECRET="change-this-to-a-random-string"
